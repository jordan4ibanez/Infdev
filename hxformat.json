{
    "whitespace": {
        "typeHintColonPolicy": "after"
    },
    "wrapping": {
        "methodChain": {
            "defaultWrap": "keep"
        },
        "callParameter": {
            "defaultWrap": "keep"
        },
        "arrayWrap": {
            "defaultWrap": "keep"
        },
        "objectLiteral": {
            "defaultWrap": "keep"
        },
        "mapWrap": {
            "defaultWrap": "keep"
        },
        "functionSignature": {
            "defaultWrap": "keep"
        }
    }
}