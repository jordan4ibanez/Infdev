-cp terraingenerator
-main terraingenerator.TerrainGenerator
-lua mods/infdev/terrain_generator.lua

# Jit.
-D lua-jit

# Disable utf8.
-D lua-vanilla

-D lua-ver=5.1

--macro LuantiCompilerFix.patch("terrain_generator.lua")

# --macro nullSafety("terraingenerator")

# This is so using vector isn't needed everywhere.
# --macro haxe.macro.Compiler.addGlobalMetadata("", "@:using(vector.Vec3)")

# This enables aggressive Dead Code Elimination.
# This is specifically used to ensure that things like the ModStorage class
# do not attempt to initialize in each thread.
# It also lightens up the deployment of each thread.
-dce full