-cp terraingenerator
-main terraingenerator.TerrainGenerator
-lua mods/infdev/terrain_generator.lua

# Jit.
-D lua-jit

# Disable utf8.
-D lua-vanilla

-D lua-ver=5.1

--macro LuantiCompilerFix.patch("terrain_generator.lua")

--macro nullSafety("terraingenerator")

# This is so using vector isn't needed everywhere.
# --macro haxe.macro.Compiler.addGlobalMetadata("", "@:using(vector.EngineVector3)")


